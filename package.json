{
  "name": "no-nonogram",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run lint && npm test && npm run build",
    "serve:dist": "vite preview --port 4173 --strictPort --host 127.0.0.1",
    "verify": "node scripts/verify-browser.mjs http://127.0.0.1:4173 verify-out",
    "perf": "node scripts/bench-render.mjs http://127.0.0.1:4173 verify-out/bench.json",
    "aim": "node scripts/probe-aim.mjs http://127.0.0.1:4173 verify-out/aim.json"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "eslint": "9.37.0",
    "globals": "16.4.0",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
